#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_NOTFAR ICON "notfar.ico"
1 RT_MANIFEST "notfar.manifest"

IDD_RENAME DIALOGEX 0, 0, 474, 302
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_STEM_LABEL, 10, 9, 132, 10
    EDITTEXT        IDC_STEM, 10, 21, 170, 15, ES_AUTOHSCROLL
    LTEXT           "", IDC_EXTENSION_LABEL, 190, 9, 62, 10
    EDITTEXT        IDC_EXTENSION, 190, 21, 71, 15, ES_AUTOHSCROLL
    LTEXT           "", IDC_START_LABEL, 273, 9, 64, 10
    EDITTEXT        IDC_START, 273, 21, 68, 15, ES_AUTOHSCROLL
    LTEXT           "", IDC_STEP_LABEL, 351, 9, 62, 10
    EDITTEXT        IDC_STEP, 351, 21, 62, 15, ES_AUTOHSCROLL
    LTEXT           "", IDC_DIGITS_LABEL, 423, 9, 38, 10
    COMBOBOX        IDC_DIGITS, 423, 21, 41, 160, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "", IDC_MASK_HELP, 10, 42, 454, 12
    CONTROL         "", IDC_PREVIEW, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 10, 61, 454, 203
    LTEXT           "", IDC_RENAME_STATUS, 10, 269, 300, 12, SS_NOPREFIX
    CONTROL         "", IDC_RENAME_PROGRESS, PROGRESS_CLASS, WS_BORDER, 10, 286, 300, 6
    DEFPUSHBUTTON   "", IDOK, 314, 273, 73, 18
    PUSHBUTTON      "", IDCANCEL, 391, 273, 73, 18
END

IDD_FILE_RENAME DIALOGEX 0, 0, 310, 70
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_FILENAME_LABEL, 9, 8, 292, 10
    EDITTEXT        IDC_FILENAME, 9, 21, 292, 15, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", IDOK, 151, 44, 72, 17
    PUSHBUTTON      "", IDCANCEL, 229, 44, 72, 17
END
