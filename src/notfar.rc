#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_NOTFAR ICON "notfar.ico"
1 RT_MANIFEST "notfar.manifest"

#ifdef NOTFAR_ARM64
#define NOTFAR_DESCRIPTION "NotFar Manager for Windows ARM64"
#else
#define NOTFAR_DESCRIPTION "NotFar Manager for Windows x64"
#endif

1 VERSIONINFO
FILEVERSION 1,5,0,0
PRODUCTVERSION 1,5,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", NOTFAR_DESCRIPTION
            VALUE "FileVersion", "1.5.0"
            VALUE "ProductName", "NotFar Manager"
            VALUE "ProductVersion", "1.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_RENAME DIALOGEX 0, 0, 474, 302
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_STEM_LABEL, 10, 9, 132, 10
    EDITTEXT        IDC_STEM, 10, 21, 170, 15, ES_AUTOHSCROLL
    LTEXT           "", IDC_EXTENSION_LABEL, 190, 9, 62, 10
    EDITTEXT        IDC_EXTENSION, 190, 21, 71, 15, ES_AUTOHSCROLL
    LTEXT           "", IDC_START_LABEL, 273, 9, 64, 10
    EDITTEXT        IDC_START, 273, 21, 68, 15, ES_AUTOHSCROLL
    LTEXT           "", IDC_STEP_LABEL, 351, 9, 62, 10
    EDITTEXT        IDC_STEP, 351, 21, 62, 15, ES_AUTOHSCROLL
    LTEXT           "", IDC_DIGITS_LABEL, 423, 9, 38, 10
    COMBOBOX        IDC_DIGITS, 423, 21, 41, 160, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "", IDC_MASK_HELP, 10, 42, 454, 12
    CONTROL         "", IDC_PREVIEW, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 10, 61, 454, 203
    LTEXT           "", IDC_RENAME_STATUS, 10, 269, 300, 12, SS_NOPREFIX
    CONTROL         "", IDC_RENAME_PROGRESS, PROGRESS_CLASS, WS_BORDER, 10, 286, 300, 6
    DEFPUSHBUTTON   "", IDOK, 314, 273, 73, 18
    PUSHBUTTON      "", IDCANCEL, 391, 273, 73, 18
END

IDD_FILE_RENAME DIALOGEX 0, 0, 310, 70
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_FILENAME_LABEL, 9, 8, 292, 10
    EDITTEXT        IDC_FILENAME, 9, 21, 292, 15, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", IDOK, 151, 44, 72, 17
    PUSHBUTTON      "", IDCANCEL, 229, 44, 72, 17
END

200 RCDATA "third_party/miniz/LICENSE"

IDD_TEXT_VIEW DIALOGEX 0, 0, 474, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Consolas"
BEGIN
    EDITTEXT        IDC_DOCUMENT_TEXT, 8, 8, 458, 260, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_HSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "", IDOK, 317, 275, 72, 17
    PUSHBUTTON      "", IDCANCEL, 394, 275, 72, 17
END

IDD_PATH_PROMPT DIALOGEX 0, 0, 360, 70
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_FILENAME_LABEL, 9, 8, 340, 10
    EDITTEXT        IDC_FILENAME, 9, 21, 272, 15, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_BROWSE_FOLDER, 287, 20, 64, 17
    DEFPUSHBUTTON   "", IDOK, 201, 44, 72, 17
    PUSHBUTTON      "", IDCANCEL, 279, 44, 72, 17
END

IDD_COPY_PROMPT DIALOGEX 0, 0, 360, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_FILENAME_LABEL, 9, 8, 340, 10
    EDITTEXT        IDC_FILENAME, 9, 21, 272, 15, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_BROWSE_FOLDER, 287, 20, 64, 17
    AUTOCHECKBOX    "", IDC_COPY_PERMISSIONS, 9, 42, 340, 13, WS_TABSTOP
    DEFPUSHBUTTON   "", IDOK, 201, 61, 72, 17
    PUSHBUTTON      "", IDCANCEL, 279, 61, 72, 17
END

IDD_FOLDER_PICKER DIALOGEX 0, 0, 388, 242
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    COMBOBOX        IDC_FOLDER_DRIVE, 9, 10, 49, 145, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    EDITTEXT        IDC_FOLDER_PATH, 64, 10, 267, 15, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_FOLDER_UP, 337, 9, 42, 17
    CONTROL         "", IDC_FOLDER_LIST, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | LVS_SHOWSELALWAYS, 9, 32, 370, 168
    LTEXT           "", IDC_FOLDER_STATUS, 9, 206, 370, 11, SS_NOPREFIX | SS_ENDELLIPSIS
    DEFPUSHBUTTON   "", IDOK, 219, 219, 92, 16
    PUSHBUTTON      "", IDCANCEL, 317, 219, 62, 16
END
